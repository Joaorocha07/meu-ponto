# Obrigatório. Chave que criptografa o cookie de sessão (contém a senha do funcionário).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar esta chave desconecta todos os usuários.
SESSION_SECRET=

# Código da empresa na Secullum.
SECULLUM_BANCO=137686

# Acompanha a versão do site oficial; é o primeiro ponto a quebrar se a Secullum exigir versão mínima.
SECULLUM_VERSAO=1.45.0

# Opcionais.
# SECULLUM_BASE_URL=https://pontowebapp.secullum.com.br
# APP_TIMEZONE=America/Sao_Paulo

# Para testar sem a API real (npm run mock, usuário 12345678, senha 1234):
# SECULLUM_BASE_URL=http://localhost:4010
